# ============================================================
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
#   cp .env.local.example .env.local
# Lấy ở Supabase: Project Settings → API
# ============================================================

# URL dự án Supabase (dạng https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Khóa "anon public" (an toàn để dùng ở trình duyệt)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# (Tùy chọn) Mã PIN "khóa nhẹ" cho trang /admin.
# Để trống = ai cũng vào được trang quản trị.
NEXT_PUBLIC_ADMIN_PIN=2010
